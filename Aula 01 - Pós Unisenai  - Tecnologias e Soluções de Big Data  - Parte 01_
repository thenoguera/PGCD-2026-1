5);\n","      filter: drop-shadow(0px 1px 2px rgba(0, 0, 0, 0.3));\n","      fill: #FFFFFF;\n","    }\n","  </style>\n","\n","    <script>\n","      const buttonEl =\n","        document.querySelector('#df-9078b901-8212-4fc1-83d8-3da8cea5cc55 button.colab-df-convert');\n","      buttonEl.style.display =\n","        google.colab.kernel.accessAllowed ? 'block' : 'none';\n","\n","      async function convertToInteractive(key) {\n","        const element = document.querySelector('#df-9078b901-8212-4fc1-83d8-3da8cea5cc55');\n","        const dataTable =\n","          await google.colab.kernel.invokeFunction('convertToInteractive',\n","                                                    [key], {});\n","        if (!dataTable) return;\n","\n","        const docLinkHtml = 'Like what you see? Visit the ' +\n","          '<a target=\"_blank\" href=https://colab.research.google.com/notebooks/data_table.ipynb>data table notebook</a>'\n","          + ' to learn more about interactive tables.';\n","        element.innerHTML = '';\n","        dataTable['output_type'] = 'display_data';\n","        await google.colab.output.renderOutput(dataTable, element);\n","        const docLink = document.createElement('div');\n","        docLink.innerHTML = docLinkHtml;\n","        element.appendChild(docLink);\n","      }\n","    </script>\n","  </div>\n","\n","\n","    </div>\n","  </div>\n"],"application/vnd.google.colaboratory.intrinsic+json":{"type":"dataframe","variable_name":"df","summary":"{\n  \"name\": \"df\",\n  \"rows\": 1000,\n  \"fields\": [\n    {\n      \"column\": \"titulo\",\n      \"properties\": {\n        \"dtype\": \"string\",\n        \"num_unique_values\": 810,\n        \"samples\": [\n          \"Bolsa supera 133 mil pontos, maior n\\u00c3\\u00advel desde outubro de 2024; d\\u00c3\\u00b3lar sobe\",\n          \"V\\u00c3\\u00addeo: Jovem \\u00c3\\u00a9 preso ao agredir namorada em pizzaria na zona norte do Rio\",\n          \"Ster lan\\u00c3\\u00a7a aquecimento de funk com violino: \\\"Puro suco do Rio de Janeiro\\\"\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"url\",\n      \"properties\": {\n        \"dtype\": \"string\",\n        \"num_unique_values\": 1000,\n        \"samples\": [\n          \"https://www.cnnbrasil.com.br/entretenimento/relembre-a-carreira-de-maria-gladys-filha-faz-apelo-para-traze-la-ao-rio/\",\n          \"https://www.cnnbrasil.com.br/nacional/brasil/organizacao-transnacional-e-presa-transportando-drogas-por-via-maritima/\",\n          \"https://www.cnnbrasil.com.br/nacional/brasil/anvisa-proibe-venda-de-creme-dental-colgate-apos-efeitos-adversos/\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"categoria\",\n      \"properties\": {\n        \"dtype\": \"category\",\n        \"num_unique_values\": 24,\n        \"samples\": [\n          \"ultimas-noticias\",\n          \"blogs\",\n          \"politica\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"texto\",\n      \"properties\": {\n        \"dtype\": \"string\",\n        \"num_unique_values\": 639,\n        \"samples\": [\n          \"O hist\\u00c3\\u00b3rico lateral-direito Gianluca Zambrotta, campe\\u00c3\\u00a3o da Copa do Mundo pela It\\u00c3\\u00a1lia em 2006, est\\u00c3\\u00a1 enfrentando problemas f\\u00c3\\u00adsicos ap\\u00c3\\u00b3s a aposentadoria.\\nO ex-jogador que pendurou as chuteiras em 2014, revelou em entrevista ao podcast BSMT, que recebeu o diagn\\u00c3\\u00b3stico de \\\"Genu Varum\\\", tamb\\u00c3\\u00a9m conhecido como \\\"pernas arqueadas\\\". A deformidade faz com que as pernas se curvem para fora na altura dos joelhos.\\nZambrotta afirmou que ter\\u00c3\\u00a1 que cortar alguns ossos para corrigir a situa\\u00c3\\u00a7\\u00c3\\u00a3o.\\n\\\"Vou ter que fazer uma osteotomia. Basicamente, eles v\\u00c3\\u00a3o endireitar minhas pernas cortando pequenos peda\\u00c3\\u00a7os de osso acima e abaixo do meu joelho e inserindo placas para tentar evitar ter que colocar uma pr\\u00c3\\u00b3tese completa\\\".\\nGianluca Zambrotta, atualmente com 48 anos, ainda disse que os m\\u00c3\\u00a9dicos se surpreendem por ele ainda conseguir praticar esportes ou at\\u00c3\\u00a9 mesmo andar com as pernas arqueadas.\\n\\\"J\\u00c3\\u00a1 visitei tr\\u00c3\\u00aas ou quatro cirurgi\\u00c3\\u00b5es renomados do pa\\u00c3\\u00ads, e eles n\\u00c3\\u00a3o conseguem me explicar como posso ter esses joelhos e praticar atividades f\\u00c3\\u00adsicas como o padel, por exemplo. Os m\\u00c3\\u00a9dicos olham para mim e perguntam como eu ando\\\", revelou.\\nCarreira de Zambrotta\\nGianluca Zambrotta nunca teve les\\u00c3\\u00b5es graves por conta da deformidade nas pernas, mas precisou realizar tr\\u00c3\\u00aas pequenas cirurgias nos m\\u00c3\\u00basculos ao redor dos joelhos nos tempos de jogador.\\nO lateral-direito defendeu a Sele\\u00c3\\u00a7\\u00c3\\u00a3o da It\\u00c3\\u00a1lia em 98 partidas, atuando em tr\\u00c3\\u00aas Copas do Mundo, tr\\u00c3\\u00aas Eurocopas e uma Olimp\\u00c3\\u00adada.\\nPela Azzurra, o jogador foi titular e pe\\u00c3\\u00a7a fundamental no t\\u00c3\\u00adtulo Mundial de 2006, na Alemanha.\\nGianluca Zambrotta ainda teve passagens de sucesso pela Juventus, Barcelona e Milan.\\nAl\\u00c3\\u00a9m da Copa do Mundo, o ex-jogador conquistou tr\\u00c3\\u00aas Campeonatos Italianos, tr\\u00c3\\u00aas Supercopas da It\\u00c3\\u00a1lia e uma Supercopa da Espanha.\",\n          \"Uma laparotomia \\u00c3\\u00a9 uma cirurgia em que o abd\\u00c3\\u00b4men \\u00c3\\u00a9 completamente aberto, permitindo ao cirurgi\\u00c3\\u00a3o ter acesso aos \\u00c3\\u00b3rg\\u00c3\\u00a3os internos para diagnosticar e tratar condi\\u00c3\\u00a7\\u00c3\\u00b5es que n\\u00c3\\u00a3o foram previamente identificadas atrav\\u00c3\\u00a9s de exames de imagem. Nos dias de hoje, cada vez mais ela \\u00c3\\u00a9 substituida pela v\\u00c3\\u00addeo-laparoscopia, em que em vez de se abrir a cavidade abdominal completamente, s\\u00c3\\u00a3o abertas pequenas entradas para introduzir o laparoscopio (pequeno aparelho com uma c\\u00c3\\u00a2mera de v\\u00c3\\u00addeo, que permite a visualiza\\u00c3\\u00a7\\u00c3\\u00a3o interna) e os intrumentos necess\\u00c3\\u00a1rios para as incis\\u00c3\\u00b5es internas.\\nO termo \\\"explorat\\u00c3\\u00b3ria\\\" refor\\u00c3\\u00a7a justamente seu uso para investigar algo que n\\u00c3\\u00a3o se tem certeza do que \\u00c3\\u00a9 dentro do corpo do paciente, ou seja, realizar um diagn\\u00c3\\u00b3stico. No caso de Jair Bolsonaro, a localiza\\u00c3\\u00a7\\u00c3\\u00a3o exata da obstru\\u00c3\\u00a7\\u00c3\\u00a3o intestinal que causou sua disten\\u00c3\\u00a7\\u00c3\\u00a3o abdominal. Uma vez identificado o problema exato, a cirurgia pode continuar a fim de tamb\\u00c3\\u00a9m j\\u00c3\\u00a1 sanar o problema diagnosticado.\\nQuais s\\u00c3\\u00a3o as indica\\u00c3\\u00a7\\u00c3\\u00b5es de uma laparotomia?\\nDe acordo com o site Medscape, p\\u00c3\\u00a1gina norte-americana voltada ao compartilhamento de conte\\u00c3\\u00bado para atualiza\\u00c3\\u00a7\\u00c3\\u00a3o de m\\u00c3\\u00a9dicos e outros profissionais de sa\\u00c3\\u00bade, a laparotomia explorat\\u00c3\\u00b3ria costuma ser indicada nos seguintes casos:\\nDor abdominal de in\\u00c3\\u00adcio agudo e achados cl\\u00c3\\u00adnicos sugestivos de patologia intra-abdominal necessitando de cirurgia de emerg\\u00c3\\u00aancia;\\nTrauma abdominal com hemoperit\\u00c3\\u00b4nio e instabilidade hemodin\\u00c3\\u00a2mica;\\nDor abdominal cr\\u00c3\\u00b4nica;\\nEstadiamento da malignidade ovariana e da doen\\u00c3\\u00a7a de Hodgkin;\\nSangramento gastrointestinal obscuro;\\nDoen\\u00c3\\u00a7as mais raras.\\nPor que realizar uma laparotomia em Bolsonaro?\\nO gastroenterologista Alexandre Carlos, m\\u00c3\\u00a9dico-assistente do Departamento de Gastroenterologia do Hospital das Cl\\u00c3\\u00adnicas de S\\u00c3\\u00a3o Paulo (HC-FMUSP), explica o motivo para os m\\u00c3\\u00a9dicos optarem pela t\\u00c3\\u00a9cnica: \\\"por conta da complexidade do caso, a laparatomia exploradora permite que o cirurgi\\u00c3\\u00a3o acesse a cavidade com maior facilidade e o tempo de cirurgia seja menor\\\", destaca \\u00c3\\u00a0 CNN.\\nO gastroenterologista Leonardo Peixoto ressalta o risco que uma video-laparoscopia oferecia nesse caso. \\\"A introdu\\u00c3\\u00a7\\u00c3\\u00a3o \\u00c3\\u00a0s cegas do primeiro corte poderia pegar uma al\\u00c3\\u00a7a intestinal, j\\u00c3\\u00a1 que ele deve ter v\\u00c3\\u00a1rias ader\\u00c3\\u00aancias\\\", avalia o especialista \\u00c3\\u00a0 CNN.\\nEtapas da laparotomia\\nConforme explica o artigo cient\\u00c3\\u00adfico dos especialistas Maria de F\\u00c3\\u00a1tima Tazima, Yvone de Andrade Vicente e Takachi Moriya, publicado no simp\\u00c3\\u00b3sio Fundamentos em Cl\\u00c3\\u00adnica Cir\\u00c3\\u00bargica, a laparotomia geralmente \\u00c3\\u00a9 composta pelas seguintes etapas:\\nLaparotomia - abertura cir\\u00c3\\u00bargica da cavidade abdominal;\\nExplora\\u00c3\\u00a7\\u00c3\\u00a3o da cavidade abdominal para avaliar a extens\\u00c3\\u00a3o da patologia e para identificar outras poss\\u00c3\\u00adveis patologias n\\u00c3\\u00a3o diagnosticadas previamente;\\nRealiza\\u00c3\\u00a7\\u00c3\\u00a3o da cirurgia propriamente dita;\\nInvent\\u00c3\\u00a1rio ou revis\\u00c3\\u00a3o da cavidade abdominal para que se tenha certeza de que a cirurgia est\\u00c3\\u00a1 completa e bem feita e para verificar se n\\u00c3\\u00a3o foram esquecidos corpos estranhos na cavidade (compressas,gazes, agulhas, etc);\\nFechamento da cavidade.\\nComo \\u00c3\\u00a9 a recupera\\u00c3\\u00a7\\u00c3\\u00a3o ap\\u00c3\\u00b3s uma laparotomia?\\nA recupera\\u00c3\\u00a7\\u00c3\\u00a3o ap\\u00c3\\u00b3s uma laparotomia \\u00c3\\u00a9 maior do que posteriormente a uma v\\u00c3\\u00addeo-laparoscopia, a incis\\u00c3\\u00a3o demora, em m\\u00c3\\u00a9dia, seis semanas para cicatrizar. Ela deixa tamb\\u00c3\\u00a9m uma cicatriz no abd\\u00c3\\u00b4men, que com o tempo tende a desaparecer. O retorno \\u00c3\\u00a0 atividades f\\u00c3\\u00adsicas pode demorar alguns meses e a for\\u00c3\\u00a7a abdominal tende a levar dois anos para se restabelecer completamente.\\nRiscos do procedimento\\nComo qualquer cirurgia, a laparotomia n\\u00c3\\u00a3o \\u00c3\\u00a9 isenta de risco. De acordo com a cl\\u00c3\\u00adnica de refer\\u00c3\\u00aancia norte-americana Cleveland Clinic, os principais riscos de uma laparotomia s\\u00c3\\u00a3o:\\nLes\\u00c3\\u00a3o n\\u00c3\\u00a3o intencional em \\u00c3\\u00b3rg\\u00c3\\u00a3os pr\\u00c3\\u00b3ximos.\\nSangramento excessivo de vasos sangu\\u00c3\\u00adneos lesionados.\\nInfec\\u00c3\\u00a7\\u00c3\\u00a3o de ferida e cicatriza\\u00c3\\u00a7\\u00c3\\u00a3o retardada.\\n\\u00c3reas de dorm\\u00c3\\u00aancia permanente devido a danos nos nervos.\\nH\\u00c3\\u00a9rnias no local da incis\\u00c3\\u00a3o ou onde o m\\u00c3\\u00basculo foi dividido.\\nTecido cicatricial interno que pode interferir nos seus \\u00c3\\u00b3rg\\u00c3\\u00a3os (ader\\u00c3\\u00aancias abdominais).\\nObstru\\u00c3\\u00a7\\u00c3\\u00a3o intestinal devido a ader\\u00c3\\u00aancias abdominais.\\nVeja mais: Bolsonaro diz que dever\\u00c3\\u00a1 passar por cirurgia\",\n          \"A It\\u00c3\\u00a1lia anunciou uma significativa mudan\\u00c3\\u00a7a nas regras para obten\\u00c3\\u00a7\\u00c3\\u00a3o de cidadania por descend\\u00c3\\u00aancia, restringindo o acesso que antes era considerado um dos mais flex\\u00c3\\u00adveis da Europa. As novas diretrizes, reveladas pelo ministro das Rela\\u00c3\\u00a7\\u00c3\\u00b5es Exteriores do pa\\u00c3\\u00ads, Antonio Tajani, limitam a concess\\u00c3\\u00a3o da cidadania italiana apenas a descendentes de pais ou av\\u00c3\\u00b3s italianos.\\nAnteriormente, qualquer pessoa com um ancestral italiano vivo ap\\u00c3\\u00b3s 1861 poderia solicitar a cidadania, independentemente do grau de parentesco. Esta altera\\u00c3\\u00a7\\u00c3\\u00a3o representa um impacto consider\\u00c3\\u00a1vel para milhares de brasileiros que buscavam o reconhecimento de sua ascend\\u00c3\\u00aancia italiana.\\nImpacto nos processos em andamento\\nNo CNN Prime Time desta sexta-feira (28), Matheus Reis, especialista em cidadania italiana, esclarece que aqueles que j\\u00c3\\u00a1 iniciaram o processo de reconhecimento da cidadania n\\u00c3\\u00a3o ser\\u00c3\\u00a3o afetados pela nova legisla\\u00c3\\u00a7\\u00c3\\u00a3o. \\\"As pessoas que j\\u00c3\\u00a1 entraram com o processo judicial ou administrativo para reconhecimento da cidadania e tiveram os documentos recebidos pelo consulado v\\u00c3\\u00a3o ter direito \\u00c3\\u00a0 cidadania\\\", afirma.\\nA implementa\\u00c3\\u00a7\\u00c3\\u00a3o das novas regras ocorrer\\u00c3\\u00a1 de forma gradual. A partir de 2026, um novo \\u00c3\\u00b3rg\\u00c3\\u00a3o em Roma ser\\u00c3\\u00a1 respons\\u00c3\\u00a1vel por julgar os processos administrativos, centralizando as decis\\u00c3\\u00b5es que antes eram tomadas pelos consulados e comunes (\\u00c3\\u00b3rg\\u00c3\\u00a3os administrativos italianos).\\nMotiva\\u00c3\\u00a7\\u00c3\\u00b5es e implica\\u00c3\\u00a7\\u00c3\\u00b5es pol\\u00c3\\u00adticas\\nA decis\\u00c3\\u00a3o do governo italiano levanta quest\\u00c3\\u00b5es sobre suas motiva\\u00c3\\u00a7\\u00c3\\u00b5es pol\\u00c3\\u00adticas. Alguns observadores tra\\u00c3\\u00a7am paralelos com pol\\u00c3\\u00adticas restritivas de imigra\\u00c3\\u00a7\\u00c3\\u00a3o implementadas em outros pa\\u00c3\\u00adses, como os Estados Unidos durante a administra\\u00c3\\u00a7\\u00c3\\u00a3o Trump.\\nO m\\u00c3\\u00a9todo de implementa\\u00c3\\u00a7\\u00c3\\u00a3o da nova lei, por meio de um decreto, tamb\\u00c3\\u00a9m chama a aten\\u00c3\\u00a7\\u00c3\\u00a3o. Este procedimento evita um debate mais amplo no Parlamento e na sociedade civil, levantando preocupa\\u00c3\\u00a7\\u00c3\\u00b5es sobre a transpar\\u00c3\\u00aancia do processo legislativo.\\nAs mudan\\u00c3\\u00a7as nas regras de cidadania italiana representam um desafio significativo para muitos descendentes de imigrantes italianos ao redor do mundo, especialmente no Brasil, que abriga uma das maiores comunidades de origem italiana fora da It\\u00c3\\u00a1lia. A nova pol\\u00c3\\u00adtica reflete uma tend\\u00c3\\u00aancia global de endurecimento das leis de imigra\\u00c3\\u00a7\\u00c3\\u00a3o e cidadania, com potenciais implica\\u00c3\\u00a7\\u00c3\\u00b5es de longo prazo para as rela\\u00c3\\u00a7\\u00c3\\u00b5es internacionais e os fluxos migrat\\u00c3\\u00b3rios.\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"data_publicacao\",\n      \"properties\": {\n        \"dtype\": \"object\",\n        \"num_unique_values\": 892,\n        \"samples\": [\n          \"2025-03-30 06:00:45\",\n          \"2025-03-27 19:21:43\",\n          \"2025-04-11 11:17:36\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"data_coleta\",\n      \"properties\": {\n        \"dtype\": \"object\",\n        \"num_unique_values\": 1000,\n        \"samples\": [\n          \"2025-08-24 18:58:58.030039\",\n          \"2025-08-24 21:35:04.769834\",\n          \"2025-08-24 21:35:25.852525\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{},"execution_count":11}]},{"cell_type":"code","source":["df[[\"titulo\", \"categoria\", \"data_publicacao\", \"data_coleta\"]].head(3)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":143},"id":"SBuzItjxyu97","executionInfo":{"status":"ok","timestamp":1779233102905,"user_tz":180,"elapsed":68,"user":{"displayName":"Rodrigo Nogueira","userId":"12568350934946102858"}},"outputId":"ed53e9f0-1372-46b6-f916-d39ce761fe5b"},"execution_count":14,"outputs":[{"output_type":"execute_result